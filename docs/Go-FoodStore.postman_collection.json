          }
        },
        {
          "name": "Get food by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/food/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "food",
                "1"
              ]
            }
          }
        },
        {
          "name": "Get food by id (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/food/999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "food",
                "999"
              ]
            },
            "description": "Id yang tidak ada — mengembalikan 404 Food not found."
          }
        },
        {
          "name": "Create food (400 validasi)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"FoodName\": \"\",\n  \"FoodPrice\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/food/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "food",
                ""
              ]
            },
            "description": "FoodName kosong dan FoodPrice nol keduanya ditolak validator (tag `required`). Mengembalikan 400 tanpa menyentuh database."
          }
        },
        {
          "name": "Update food",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"FoodName\": \"Nasi Goreng Spesial\",\n  \"FoodPrice\": 30000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/food/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "food",
                "1"
              ]
            }
          }
        },
        {
          "name": "Delete food",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/food/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "food",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Transaction",
      "item": [
        {
          "name": "Create transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"CustomerId\": 1,\n  \"Food\": [\n    { \"FoodId\": 1, \"Quantity\": 2 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transaction/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transaction",
                ""
              ]
            },
            "description": "Butuh customer dan food yang sudah ada lebih dulu."
          }
        },
        {
          "name": "Get unpaid transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transaction/unpaid/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transaction",
                "unpaid",
                ""
              ]
            }
          }
        },
        {
          "name": "Get paid transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transaction/paid/",
