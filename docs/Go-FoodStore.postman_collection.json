          "name": "Accept payment",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transaction/acc/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transaction",
                "acc",
                "1"
              ]
            },
            "description": "Menandai transaksi lunas. Setelah ini transaksi berpindah dari /transaction/unpaid/ ke /transaction/paid/."
          }
        },
        {
          "name": "Update transaction",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"CustomerId\": 1,\n  \"Food\": [\n    { \"FoodId\": 1, \"Quantity\": 3 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transaction/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transaction",
                "1"
              ]
            },
            "description": "Mengembalikan 304 \"Can't delete paid transaction\" kalau transaksi sudah lunas — logika bisnis yang disengaja. Catatan: pesannya menyebut \"delete\" padahal ini update (salah tempel di repository)."
          }
        },
        {
          "name": "Delete transaction",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transaction/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transaction",
                "1"
              ]
            },
            "description": "Mengembalikan 304 \"Can't delete paid transaction\" kalau transaksi sudah lunas — logika bisnis yang disengaja."
          }
        }
      ]
    },
    {
      "name": "Error handling",
      "item": [
        {
          "name": "Route tidak terdaftar (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/nope",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "nope"
              ]
            },
            "description": "Ditangani router.NotFoundHandler → exception.NotFoundErr."
          }
        },
        {
          "name": "Method salah (405)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/food/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "food",
                ""
              ]
            },
            "description": "Ditangani router.MethodNotAllowedHandler → exception.NotAllowedErr."
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
