              ],
              "path": [
                "cust",
                "1"
              ]
            }
          }
        },
        {
          "name": "Update customer",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"CustomerName\": \"David Adriel Alvyn\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cust/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cust",
                "1"
              ]
            }
          }
        },
        {
          "name": "Delete customer",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cust/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cust",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Food",
      "item": [
        {
          "name": "Get all food",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/food/?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "food",
                ""
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Create food",
          "request": {
            "method": "POST",
            "header": [
