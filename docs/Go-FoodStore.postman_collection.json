            "body": {
              "mode": "raw",
              "raw": "{\n  \"CustomerName\": \"David Adriel\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cust/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cust",
                ""
              ]
            }
          }
        },
        {
          "name": "Get customer by id",
          "request": {
            "method": "GET",
            "header": [],
