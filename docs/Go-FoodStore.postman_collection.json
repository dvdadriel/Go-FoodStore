                "{{baseUrl}}"
              ],
              "path": [
                "transaction",
                "paid",
                ""
              ]
            }
          }
        },
        {
          "name": "Get transaction by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transaction/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transaction",
                "1"
              ]
            }
          }
