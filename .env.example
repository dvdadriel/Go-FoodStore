# Variabel proses, bukan file yang dibaca aplikasi. Muat dulu:
#   set -a; source .env; set +a
#
# Tidak ada loader .env di module ini; config.DSN() dan config.ServerAddr()
# membaca environment proses lewat os.LookupEnv. `cp .env.example .env` saja
# tidak berpengaruh apa pun.

# Database (MySQL)
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=go-food-store

# HTTP server
SERVER_ADDR=:8080
