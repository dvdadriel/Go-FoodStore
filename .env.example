# Variabel proses, bukan file yang dibaca aplikasi. Muat dulu:
#   set -a; source .env; set +a
#
# Tidak ada loader .env di module ini; config.DSN() dan config.ServerAddr()
# membaca environment proses lewat os.LookupEnv. `cp .env.example .env` saja
# tidak berpengaruh apa pun.

# Database (MySQL)
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=go-food-store

# HTTP server
SERVER_ADDR=:8080
CORS_ORIGIN=*

# Autentikasi
#
# JWT_SECRET wajib, minimal 32 karakter — aplikasi menolak start tanpa itu.
# Buat yang acak, jangan pakai nilai di bawah ini di luar mesin sendiri:
#   openssl rand -base64 48
JWT_SECRET=ganti-nilai-ini-dengan-kunci-acak-minimal-32-karakter
TOKEN_TTL_SECONDS=3600

# Akun admin pertama, dibuat saat start kalau belum ada. Pendaftaran terbuka
# di /auth/register selalu menghasilkan peran customer, jadi admin hanya bisa
# lahir dari sini. Kosongkan keduanya kalau tidak ingin ada admin sama sekali.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-kata-sandi-ini
